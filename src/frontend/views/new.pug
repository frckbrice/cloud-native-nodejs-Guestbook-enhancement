form.form-inline(action="/post", method="POST", enctype="multipart/form-data")
    label.sr-only(for="name") Name
    .input-group.mb-2.mr-sm-2
        .input-group-prepend
            .input-group-text Your Name
        input#name.form-control(type="text", name="name", required="")
    label.sr-only(for="message") Message
    .input-group.mb-2.mr-sm-2
        .input-group-prepend
            .input-group-text Message
        input#message.form-control(type="text", name="message", required="")
    .input-group.mb-2.mr-sm-2
        .input-group-prepend
            .input-group-text Image
        input#image.form-control-file(type="file", name="image", accept="image/*")
    button.btn.btn-primary.mb-2(type="submit") Post to Guestbook
