doctype html
html
    head
        meta(charset='utf-8')
        title Guestbook
        meta(name='viewport', content='width=device-width, initial-scale=1')
        link(rel='stylesheet', href='https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css', integrity='sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T', crossorigin='anonymous')
        link(rel='stylesheet', href='css/style.css')
        link(rel='stylesheet', href='https://fonts.googleapis.com/css?family=Roboto')
        script(src='https://code.jquery.com/jquery-3.6.0.min.js')
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/js/bootstrap.bundle.min.js')
        script(src='https://cdn.socket.io/4.7.2/socket.io.min.js')
        script.
            // Update custom file input label
            $('.custom-file-input').on('change', function() {
                let fileName = $(this).val().split('\\').pop();
                $(this).next('.custom-file-label').html(fileName || 'Choose image (optional)');
            });
            
            // Initialize Socket.IO for real-time updates
            const socket = io(window.location.origin.replace(/:\d+$/, ':8080'));
            
            socket.on('connect', function() {
                console.log('Connected to real-time updates');
            });
            
            socket.on('disconnect', function() {
                console.log('Disconnected from real-time updates');
            });
            
            // Listen for new messages
            socket.on('message:created', function(message) {
                console.log('New message received:', message);
                // Reload page to show new message (or implement dynamic insertion)
                location.reload();
            });
            
            // Listen for message updates
            socket.on('message:updated', function(message) {
                console.log('Message updated:', message);
                location.reload();
            });
            
            // Listen for message deletions
            socket.on('message:deleted', function(data) {
                console.log('Message deleted:', data.id);
                location.reload();
            });
    body
        .header
            .container
                h1 
                    a(href='/') My Guestbook
                a(href='https://github.com/GoogleCloudPlatform/cloud-code-samples').text-muted View on Github
        .container.posts.mt-0
            if error
                .alert.alert-danger(role='alert')
                    | #{error}
            include new.pug
            include list.pug
        
        // Edit Message Modal
        #editModal.modal.fade(tabindex='-1' role='dialog')
            .modal-dialog(role='document')
                .modal-content
                    .modal-header
                        h5.modal-title Edit Message
                        button.close(type='button' data-dismiss='modal' aria-label='Close')
                            span(aria-hidden='true') ×
                    .modal-body
                        form#editForm(enctype='multipart/form-data')
                            input#editId(type='hidden')
                            .form-group
                                label(for='editName') Your Name
                                input#editName.form-control(type='text' name='name' required)
                            .form-group
                                label(for='editBody') Message
                                textarea#editBody.form-control(name='body' rows='3' required)
                            .form-group
                                label(for='editImage') Image (optional)
                                input#editImage.form-control-file(type='file' name='image' accept='image/*')
                                small.form-text.text-muted Current image will be replaced if a new one is uploaded
                    .modal-footer
                        button.btn.btn-secondary(type='button' data-dismiss='modal') Cancel
                        button.btn.btn-primary(type='submit' form='editForm') Save Changes
        
        script.
            $(document).ready(function() {
                // Delete message
                $('.delete-btn').on('click', function() {
                    const messageId = $(this).data('id');
                    if (confirm('Are you sure you want to delete this message?')) {
                        $.ajax({
                            url: `/messages/${messageId}`,
                            type: 'DELETE',
                            success: function() {
                                location.reload();
                            },
                            error: function(xhr) {
                                alert('Failed to delete message. Please try again.');
                            }
                        });
                    }
                });
                
                // Edit message
                $('.edit-btn').on('click', function() {
                    const id = $(this).data('id');
                    const name = $(this).data('name');
                    const body = $(this).data('body');
                    
                    $('#editId').val(id);
                    $('#editName').val(name);
                    $('#editBody').val(body);
                    $('#editModal').modal('show');
                });
                
                // Submit edit form
                $('#editForm').on('submit', function(e) {
                    e.preventDefault();
                    const id = $('#editId').val();
                    const formData = new FormData();
                    formData.append('name', $('#editName').val());
                    formData.append('body', $('#editBody').val());
                    
                    const imageFile = $('#editImage')[0].files[0];
                    if (imageFile) {
                        formData.append('image', imageFile);
                    }
                    
                    $.ajax({
                        url: `/messages/${id}`,
                        type: 'PUT',
                        processData: false,
                        contentType: false,
                        data: formData,
                        success: function() {
                            $('#editModal').modal('hide');
                            location.reload();
                        },
                        error: function(xhr) {
                            alert('Failed to update message. Please try again.');
                        }
                    });
                });
            });
